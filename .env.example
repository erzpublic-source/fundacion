# Copy this file to .env.local (gitignored) and fill in the values from
# your Supabase project: Settings → Data API (URL) and Settings → API Keys
# (anon/public key, under either "Publishable and secret API keys" or the
# "Legacy anon, service_role API keys" tab). Never put the service_role /
# secret key here — only the anon/public key belongs in client-side code.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# reCAPTCHA v2 site key (Google reCAPTCHA admin → your site → Settings).
# Registered per domain, so staging and production use different keys.
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
